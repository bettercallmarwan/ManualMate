{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ManualMateDbContext": "Host=localhost;Port=5432;Database=ManualMate;Username=postgres;Password=<your-postgres-password>",
    "Redis": "localhost:6379"
  },
  "RedisSettings": {
    "TimeToLiveInHours": "24"
  },
  "HuggingFace": {
    "ApiToken": "<your-huggingface-api-token>",
    "ModelUrl": "https://router.huggingface.co/hf-inference/models/BAAI/bge-small-en-v1.5"
  },
  "Gemini": {
    "GeminiToken": "<your-gemini-api-key>",
    "ModelUrl": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent?key="
  },
  "RAG": {
    "top_k": "7",
    "context_separator": "\n\n---\n\n"
  },
  "FileStorage": {
    "UploadPath": "wwwroot/Files"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "admin",
    "Password": "<your-rabbitmq-password>"
  }
}
